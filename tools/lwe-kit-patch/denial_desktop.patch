+
+class _WallpaperGrid extends ConsumerWidget {
+  const _WallpaperGrid({
+    required this.wallpapers,
+    required this.playlist,
+    required this.activeId,
+    required this.enabled,
+    required this.onToggle,
+  });
+
+  final AsyncValue<List<WorkshopWallpaper>> wallpapers;
+  final List<String> playlist;
+  final String? activeId;
+  final bool enabled;
+  final ValueChanged<String> onToggle;
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final colors = Theme.of(context);
+    return wallpapers.when(
+      loading: () => const Padding(
+        padding: EdgeInsets.symmetric(vertical: 18),
+        child: Center(child: CircularProgressIndicator()),
+      ),
+      error: (error, _) => Text(
+        '读取 Workshop 壁纸失败：$error',
+        style: colors.textTheme.bodyMedium,
+      ),
+      data: (items) {
+        if (items.isEmpty) {
+          return Text(
+            '未找到 Workshop 壁纸。请先在 Steam 的 Wallpaper Engine 创意工坊订阅并下载至少一个壁纸。',
+            style: colors.textTheme.bodyMedium,
+          );
+        }
+        return Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Row(
+              children: [
+                Text(
+                  '轮换列表（${playlist.length}/${items.length}）',
+                  style: colors.textTheme.titleSmall,
+                ),
+                const SizedBox(width: 12),
+                Text(
+                  '单击勾选加入/移出轮换',
+                  style: colors.textTheme.bodySmall?.copyWith(
+                    color: colors.colorScheme.onSurfaceVariant,
+                  ),
+                ),
+              ],
+            ),
+            const SizedBox(height: 12),
+            LayoutBuilder(
+              builder: (context, constraints) {
+                const minTile = 148.0;
+                final columns =
+                    (constraints.maxWidth / minTile).floor().clamp(2, 6);
+                return GridView.builder(
+                  shrinkWrap: true,
+                  physics: const NeverScrollableScrollPhysics(),
+                  gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
+                    crossAxisCount: columns,
+                    mainAxisSpacing: 10,
+                    crossAxisSpacing: 10,
+                    childAspectRatio: 16 / 11,
+                  ),
+                  itemCount: items.length,
+                  itemBuilder: (context, index) {
+                    final item = items[index];
+                    final inPlaylist = playlist.contains(item.id);
+                    final active = item.id == activeId;
+                    return _WallpaperTile(
+                      item: item,
+                      inPlaylist: inPlaylist,
+                      active: active,
+                      enabled: enabled,
+                      onTap: () => onToggle(item.id),
+                    );
+                  },
+                );
+              },
+            ),
+          ],
+        );
+      },
+    );
+  }
+}
+
+class _WallpaperTile extends StatelessWidget {
+  const _WallpaperTile({
+    required this.item,
+    required this.inPlaylist,
+    required this.active,
+    required this.enabled,
+    required this.onTap,
+  });
+
+  final WorkshopWallpaper item;
+  final bool inPlaylist;
+  final bool active;
+  final bool enabled;
+  final VoidCallback onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final colors = theme.colorScheme;
+    final borderRadius = BorderRadius.circular(12);
+    return Opacity(
+      opacity: enabled ? 1 : 0.45,
+      child: InkWell(
+        borderRadius: borderRadius,
+        onTap: enabled ? onTap : null,
+        child: DecoratedBox(
+          decoration: BoxDecoration(
+            borderRadius: borderRadius,
+            border: Border.all(
+              color: active
+                  ? colors.primary
+                  : inPlaylist
+                  ? colors.primary.withValues(alpha: .55)
+                  : colors.outlineVariant,
+              width: active ? 2 : 1,
+            ),
+          ),
+          child: ClipRRect(
+            borderRadius: borderRadius,
+            child: Stack(
+              fit: StackFit.expand,
+              children: [
+                if (item.preview != null)
+                  Image.file(
+                    File(item.preview!),
+                    fit: BoxFit.cover,
+                    errorBuilder: (_, _, _) =>
+                        ColoredBox(color: colors.surfaceContainerHighest),
+                  )
+                else
+                  ColoredBox(color: colors.surfaceContainerHighest),
+                Positioned(
+                  left: 0,
+                  right: 0,
+                  bottom: 0,
+                  child: DecoratedBox(
+                    decoration: BoxDecoration(
+                      gradient: LinearGradient(
+                        begin: Alignment.topCenter,
+                        end: Alignment.bottomCenter,
+                        colors: [
+                          colors.surface.withValues(alpha: 0),
+                          colors.surface.withValues(alpha: 0.92),
+                        ],
+                      ),
+                    ),
+                    child: Padding(
+                      padding: const EdgeInsets.fromLTRB(8, 14, 8, 6),
+                      child: Row(
+                        children: [
+                          Expanded(
+                            child: Text(
+                              item.title,
+                              maxLines: 1,
+                              overflow: TextOverflow.ellipsis,
+                              style: theme.textTheme.labelMedium,
+                            ),
+                          ),
+                          if (inPlaylist)
+                            Icon(
+                              Icons.loop_rounded,
+                              size: 13,
+                              color: colors.primary,
+                            ),
+                          if (active) ...[
+                            const SizedBox(width: 4),
+                            Icon(
+                              Icons.check_circle_rounded,
+                              size: 14,
+                              color: colors.primary,
+                            ),
+                          ],
+                        ],
+                      ),
+                    ),
+                  ),
+                ),
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
